# Local, non-secret settings for development. Copy to .env when a tool needs them.
#
# Secrets (API keys, tokens, webhook signing keys) never go in an env file, this
# one or any other: Cloud Functions read them from Secret Manager
# (`firebase functions:secrets:set NAME`, then `defineSecret('NAME')` in code).

# Emulator hosts (match firebase.json)
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_DATABASE_EMULATOR_HOST=localhost:9000
FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199
FUNCTIONS_EMULATOR_HOST=localhost:5001

# Application
NODE_ENV=development
LOG_LEVEL=debug
