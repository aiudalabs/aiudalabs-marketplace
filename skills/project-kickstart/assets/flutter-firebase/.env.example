# Emulator hosts for local tools and scripts (match firebase.json). Copy to .env when a tool needs them.
#
# Only emulator hosts belong here. Secrets (API keys, tokens, webhook signing keys) never go in an
# env file: Cloud Functions read them from Secret Manager (`firebase functions:secrets:set NAME`,
# then `defineSecret('NAME')` in code). Non-secret function parameters live in functions/.env.<alias>;
# emulator-only ones in functions/.env.local (from functions/.env.local.example).
#
# 127.0.0.1, not localhost: the emulators bind IPv4 only (firebase.json), and localhost may resolve
# to ::1. An Android emulator reaches the host at 10.0.2.2.

FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
FUNCTIONS_EMULATOR_HOST=127.0.0.1:5001
