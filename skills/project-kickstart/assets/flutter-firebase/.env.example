# Firebase project configuration (per environment)
# These values are filled by `firebase use --add`; this file is committed-friendly.

# Local emulator overrides (optional)
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_DATABASE_EMULATOR_HOST=localhost:9000
FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199
FUNCTIONS_EMULATOR_HOST=localhost:5001

# Application
NODE_ENV=development
LOG_LEVEL=debug

# Third-party (filled per environment, NEVER commit real values)
SENTRY_DSN=
YAPPY_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
