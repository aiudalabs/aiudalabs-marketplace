{
  "name": "{{project_name}}",
  "version": "0.1.0",
  "private": true,
  "description": "{{project_title}}",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">={{node_version}}",
    "pnpm": ">=10"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "emulators": "firebase emulators:start --import=./emulator-data --export-on-exit",
    "emulators:test": "firebase emulators:exec --only firestore,functions,auth 'pnpm -r --if-present test:integration'",
    "rules:test": "firebase emulators:exec --only firestore 'pnpm --dir functions run test:rules'",
    "deploy:staging": "firebase use staging && firebase deploy",
    "deploy:prod": "firebase use prod && firebase deploy"
  },
  "devDependencies": {
    "firebase-tools": "^15.0.0",
    "typescript": "~5.9.0"
  }
}
