{
  "name": "@{{project_name}}/functions",
  "version": "0.1.0",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "{{node_version}}"
  },
  "scripts": {
    "gen:index": "node scripts/gen-index.mjs",
    "build": "node scripts/gen-index.mjs && tsc",
    "build:watch": "node scripts/gen-index.mjs && tsc --watch",
    "lint": "node scripts/gen-index.mjs && eslint src",
    "typecheck": "node scripts/gen-index.mjs && tsc --noEmit",
    "test": "node scripts/gen-index.mjs && vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:rules": "vitest run --config vitest.rules.config.ts --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.6.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.0",
    "firebase": "^12.0.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.0"
  }
}
