---
# =============================================================================
# @@TITLE@@ — print interior master
# Generated by book-typesetting/scripts/init-book.sh
#
# Render:  quarto render book-print.qmd --to pdf   ->  _output/book-print.pdf
# Then:    scripts/press-pdf.sh --title "@@TITLE@@" \
#              _output/book-print.pdf _output/interior-CMYK-X1a.pdf
#
# Trim: @@W@@ x @@H@@ in, no bleed. Margins are mirrored (twoside), so this one
# interior suits both a paperback and a case-laminate hardcover edition.
#
# ADDING CHAPTERS
#   Add one include per chapter in the CHAPTERS section below, in reading order.
#   Paths are relative to THIS file, hence the leading ../
#
#       {{< include ../chapters/Chapter-2-Another-Title.print.md >}}
#
#   NOTE: Quarto expands include shortcodes even inside HTML comments, so never
#   "comment out" a chapter with <!-- -->. Delete the line instead.
#
# ADDING A PART DIVIDER
#   If the book is grouped into parts, insert a raw-LaTeX block between chapters
#   containing \partblurb{One-line description.} then \part{Part Title}.
# =============================================================================
title: "@@TITLE@@"
subtitle: "@@SUBTITLE@@"
author: "@@AUTHOR@@"
date: "@@YEAR@@"
date-format: "YYYY"
lang: en-US
top-level-division: chapter
toc: false                 # an inline \tableofcontents is used instead
toc-depth: 1
filters:
@@FILTERS@@
format:
  pdf:
    documentclass: scrbook
    classoption:
      - twoside
      - open=right             # chapters always start on a recto
      - cleardoublepage=empty  # the inserted blank verso carries no head/folio
      - 10pt
      - numbers=noendperiod
      - BCOR=0in               # binding correction is folded into `inner` below
    papersize: letter          # overridden by the explicit geometry below
    geometry:
      - paperwidth=@@W@@in
      - paperheight=@@H@@in
      - top=0.65in
      - bottom=0.9in           # room for pooled footnotes above the folio
      - inner=0.75in           # gutter (binding side), mirrored recto/verso
      - outer=0.5in
      - columnsep=0.3in
      - headheight=14pt
      - headsep=14pt
      - footskip=43pt
    fontsize: 10pt
    linestretch: 1.12
    colorlinks: true
    linkcolor: black
    urlcolor: black
    citecolor: black
    toccolor: black
    fig-pos: "H"
    fig-cap-location: bottom
    number-sections: true
    number-depth: 0            # number chapters only, not sections
    crossref:
      fig-title: ""
      fig-prefix: "Figure"
      title-delim: ""
    hyperrefoptions:
      - bookmarksopen=true
      - breaklinks=true
    # Fail fast and loudly. Without this a LaTeX error drops into an interactive
    # prompt and the render appears to hang forever.
    pdf-engine-opts:
      - "-interaction=nonstopmode"
    include-in-header:
      text: |
        %% ---- fonts & micro-typography ----
        \usepackage[T1]{fontenc}
        \usepackage{lmodern}
        %% Under LuaTeX/XeTeX, \usepackage{lmodern} alone does NOT get TeX dash
        %% ligatures (--- / --) through luaotfload. Re-load via fontspec so
        %% em- and en-dashes render as dashes, not runs of hyphens.
        \usepackage{iftex}
        \ifPDFTeX\else
          \setmainfont{Latin Modern Roman}[Ligatures=TeX]
          \setsansfont{Latin Modern Sans}[Ligatures=TeX]
        \fi
        \usepackage{microtype}
@@FONT_FALLBACK@@
        %% ---- house accent colour (used by chapter heads and the finial) ----
        \usepackage{xcolor}
        \definecolor{BookAccent}{HTML}{@@ACCENT@@}
        \definecolor{varblue}{HTML}{1F3A93}
        %% ---- index (entries tagged in prose via \index{}) ----
        \usepackage{imakeidx}
        \makeindex[intoc=true, columns=2, title={Index}]
        %% ---- structure / layout ----
        \usepackage{float}
        \usepackage{dblfloatfix}
        \usepackage[headsepline=0.4pt]{scrlayer-scrpage}
        \usepackage{lastpage}
        \usepackage{titlesec}
        \usepackage{enumitem}
        \usepackage{ragged2e}
        \usepackage{xurl}        % break long URLs anywhere: never overflow a column
        %% Keep the footnote MARK inside the text block instead of hanging it
        %% into the margin (KOMA's default overhangs by ~11pt).
        \deffootnote{1.8em}{1.8em}{\textsuperscript{\thefootnotemark}}
        \usepackage{tcolorbox}
        \tcbuselibrary{skins,breakable}
        \usepackage{caption}
        \usepackage{graphicx}
        \usepackage[normalem]{ulem}
        %% ---- missing-image guard: draw a visible placeholder instead of
        %%      failing the build, so a work-in-progress chapter still compiles.
        %%      CHECK THE PDF for these boxes -- they are not build errors. ----
        \makeatletter
        \let\book@origincludegraphics\includegraphics
        \renewcommand{\includegraphics}[2][]{%
          \IfFileExists{#2}%
            {\book@origincludegraphics[#1]{#2}}%
            {\fbox{\parbox{0.5\linewidth}{\centering\ttfamily\scriptsize [missing image]\\\detokenize{#2}}}}%
        }
        \makeatother
        %% ---- tables ----
        \usepackage{array}
        \usepackage{booktabs}
        \usepackage{tabularx}
        \newcolumntype{Y}{>{\raggedright\arraybackslash}X}
        \usepackage{etoolbox}
        \AtBeginEnvironment{longtable}{\footnotesize}
        \AtBeginEnvironment{tabular}{\footnotesize}
        \AtBeginEnvironment{tabularx}{\footnotesize}
@@MULTICOL_PACKAGES@@
        %% ---- inline variable macro: [x]{.var} -> \var{x} ----
        \newcommand{\var}[1]{\ifmmode\textcolor{varblue}{\mathit{#1}}\else\textcolor{varblue}{\textit{#1}}\fi}
        %% ---- image / caption defaults ----
        \setkeys{Gin}{width=\linewidth,keepaspectratio}
        \DeclareCaptionFont{figcap}{\fontsize{7.5pt}{9.5pt}\selectfont}
        \captionsetup[figure]{font=figcap,labelformat=empty,labelsep=none,%
                              justification=raggedright,singlelinecheck=false,skip=7pt}
        \setlist[itemize]{leftmargin=1.1em,topsep=2pt,itemsep=2pt,parsep=0pt}
        \setlist[enumerate]{leftmargin=1.4em,topsep=2pt,itemsep=2pt,parsep=0pt}
        %% ---- section heads (chapter heads handled by KOMA) ----
        \titleformat{\section}{\sffamily\bfseries\fontsize{14}{17}\selectfont\color{black!85}}{}{0pt}{}
        \titleformat{\subsection}{\sffamily\bfseries\fontsize{12}{14.5}\selectfont\color{black!85}}{}{0pt}{}
        \titleformat{\subsubsection}{\sffamily\bfseries\fontsize{11}{13.5}\selectfont}{}{0pt}{}
        \titleformat{\paragraph}[runin]{\sffamily\bfseries\small}{}{0pt}{}[.]
        \titlespacing{\section}{0pt}{14pt}{6pt}
        \titlespacing{\subsection}{0pt}{14pt}{6pt}
        \titlespacing{\subsubsection}{0pt}{10pt}{4pt}
        \titlespacing{\paragraph}{0pt}{8pt}{0.6em}
        %% ---- KOMA chapter & part fonts ----
        \setkomafont{chapter}{\sffamily\bfseries\fontsize{28}{33}\selectfont\color{BookAccent}}
        \setkomafont{chapterprefix}{\sffamily\normalsize\color{black!55}}
        \renewcommand*{\chapterheadstartvskip}{\vspace*{2.5\baselineskip}}
        \renewcommand*{\chapterheadendvskip}{\vspace{2\baselineskip}}
        \setkomafont{part}{\sffamily\bfseries\color{BookAccent}}
        \setkomafont{partnumber}{\sffamily\normalsize\color{black!55}}
        %% ---- chapter heading: inline "N. Title" (no "Chapter" prefix word) ----
        \setcounter{secnumdepth}{0}
        \renewcommand*{\chapterformat}{\thechapter.\enskip}
        \renewcommand*{\chapterlinesformat}[3]{\raggedchapter #2#3}
        %% ---- running heads: verso = part, recto = chapter, folio centred ----
        \setkomafont{pagehead}{\normalfont\sffamily\small}
        \setkomafont{pagenumber}{\normalfont\sffamily\small}
        \clearpairofpagestyles
        \lehead{\leftmark}
        \rohead{\itshape\rightmark}
        \cfoot*{\pagemark}
        \renewcommand*{\chaptermark}[1]{\markright{\thechapter.\ #1}}
        %% sections must not touch the mark, or they overwrite the recto head
        \renewcommand*{\sectionmark}[1]{}
        \renewcommand*{\subsectionmark}[1]{}
        \renewcommand*{\chapterpagestyle}{plain}
        \pagestyle{scrheadings}
        %% ---- paragraph / column tuning ----
        %% \raggedbottom: KOMA twoside defaults to \flushbottom, which stretches
        %% each page to \textheight -- under multicol that pushes the pooled
        %% footnote block down into the folio.
        \raggedbottom
        \setlength{\columnseprule}{0pt}
        \setlength{\parskip}{3pt plus 1pt minus 1pt}
        \setlength{\emergencystretch}{2em}
        %% Body justified; footnotes ragged-right so long URLs don't gap.
        \makeatletter
        \let\book@oldmkfn\@makefntext
        \renewcommand{\@makefntext}[1]{\book@oldmkfn{\RaggedRight #1}}
        \makeatother
        \setlength{\skip\footins}{18pt plus 4pt minus 2pt}
        \renewcommand{\footnoterule}{\vspace{3pt}\hrule width \textwidth height 0.4pt\vspace{6pt}}
        %% ---- custom inline title pages are used; suppress Quarto's \maketitle ----
        \AtBeginDocument{\let\maketitle\relax}
        %% ---- callout box ----
        \tcbset{
          callout/.style={
            colback=black!4,colframe=black!25,boxrule=0.4pt,arc=2pt,
            left=6pt,right=6pt,top=4pt,bottom=4pt,
            before skip=6pt,after skip=6pt
          }
        }
        \providecommand{\tightlist}{\setlength{\itemsep}{2pt}\setlength{\parskip}{0pt}}
        %% ---- QR macros + rules ----
        \input{qr.tex}
        \newcommand{\thematicrule}{%   % scene break, emitted from `---`
          \par\addvspace{10pt}%
          {\centering\textcolor{black!40}{\rule{0.30\linewidth}{0.6pt}}\par}%
          \addvspace{10pt}%
          \nopagebreak[4]%
        }
        %% ---- chapter-end finial, auto-placed before each "## Endnotes" ----
        \newcommand{\chapterend}{%
          \par\addvspace{12pt}%
          {\centering\normalsize\color{BookAccent}\textasteriskcentered\quad\textasteriskcentered\quad\textasteriskcentered\par}%
          \addvspace{8pt}%
        }
        %% ---- table of contents depth ----
        %% The TOC below is an inline \tableofcontents, so Quarto's `toc-depth`
        %% does not reach it -- LaTeX's own counter governs. In scrbook: part=-1,
        %% chapter=0, section=1. 0 lists chapters only, which is what a trade
        %% book wants; raise to 1 to list sections too.
        \setcounter{tocdepth}{0}
        %% ---- widow / orphan control ----
        \widowpenalty=10000
        \clubpenalty=10000
        \displaywidowpenalty=10000
        %% ---- part-divider blurb helper ----
        \newcommand{\partblurb}[1]{\setpartpreamble[c][0.82\linewidth]{\centering\normalsize\itshape #1\par\vspace{1.5em}}}
---

```{=latex}
\frontmatter
\pagestyle{plain}
```

<!-- ========================= HALF-TITLE (recto) ========================= -->
```{=latex}
\thispagestyle{empty}
\vspace*{0.30\textheight}
\begin{center}
  {\sffamily\bfseries\Huge\color{BookAccent} @@TITLE@@}
\end{center}
\clearpage
\thispagestyle{empty}\null\clearpage
```

<!-- ========================= TITLE PAGE (recto) ========================= -->
```{=latex}
\thispagestyle{empty}
\vspace*{0.22\textheight}
\begin{center}
  {\sffamily\bfseries\Huge\color{BookAccent} @@TITLE@@}\\[1.0em]
@@SUBTITLE_TEX@@  {\sffamily\Large @@AUTHOR@@}
  \vfill
  {\sffamily\small @@PUBLISHER@@}
\end{center}
\clearpage
```

